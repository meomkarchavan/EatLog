rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Daily meal logs: only the authenticated owner can read/write their own logs
    match /daily_logs/{logId} {
      allow read, write: if request.auth != null
                         && (resource == null || request.auth.uid == resource.data.user_id);
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.user_id;
    }

    // Water logs: only the authenticated owner can read/write their own water logs
    match /water_logs/{waterLogId} {
      allow read, write: if request.auth != null
                         && (resource == null || request.auth.uid == resource.data.user_id);
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.user_id;
    }

    // Weight logs: only the authenticated owner can read/write their own morning weight logs
    match /weight_logs/{weightLogId} {
      allow read, write: if request.auth != null
                         && (resource == null || request.auth.uid == resource.data.user_id);
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.user_id;
    }

    // User profiles: only the authenticated owner can read/write their profile and dynamic targets
    match /user_profiles/{userId} {
      allow read, write: if request.auth != null
                         && (resource == null || request.auth.uid == userId);
      allow create: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Lookup history: only the authenticated owner can read/write their lookup history
    match /lookup_history/{historyId} {
      allow read, write: if request.auth != null
                         && (resource == null || request.auth.uid == resource.data.userId || request.auth.uid == resource.data.user_id);
      allow create: if request.auth != null
                    && (request.auth.uid == request.resource.data.userId || request.auth.uid == request.resource.data.user_id);
    }
  }
}
